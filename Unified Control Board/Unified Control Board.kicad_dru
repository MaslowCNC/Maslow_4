(version 1)

# MP6541A (U11, U12) land pattern has 0.1 mm pad-to-pad gaps. JLCPCB's 4-layer
# minimum spacing is 0.09 mm, so allow 0.1 mm between pads of the same driver only.
(rule "MP6541A pad-to-pad"
	(constraint clearance (min 0.1mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('U11') && B.memberOfFootprint('U11')) || (A.memberOfFootprint('U12') && B.memberOfFootprint('U12')))"))

# Flag narrow sections on high-current nets (warnings: pad escapes may need to neck down).
(rule "Motor min width"
	(severity warning)
	(constraint track_width (min 1.0mm))
	(condition "A.NetClass == 'Motor'"))

(rule "Power min width"
	(severity warning)
	(constraint track_width (min 0.5mm))
	(condition "A.NetClass == 'Power'"))

# Phase nets also carry deliberate 0.3 mm copper: the drivers' SHx Kelvin pins, the bootstrap caps, the high-side
# gate pull-downs and the phase-sense taps. Those are not motor current paths; any other narrowing still warns.
(rule "Motor Kelvin and sense taps"
	(severity warning)
	(constraint track_width (min 0.3mm))
	(condition "A.NetClass == 'Motor' && A.Width < 0.35mm"))

# Small power pours stay whole: no other net's tracks through them, except to reach a pad inside
# (areas ISL_nn, made by island_areas.py; rules by island_rules.py).
(rule "ISL_00: PHA2 PHA2 top Q21/Q20 F.Cu stays whole"
	(layer F.Cu)
	(constraint disallow track)
	(condition "A.intersectsArea('ISL_00') && A.NetName != 'PHA2'"))

(rule "ISL_01: VCC pour F.Cu stays whole"
	(layer F.Cu)
	(constraint disallow track)
	(condition "A.intersectsArea('ISL_01') && A.NetName != 'VCC' && A.NetName != 'GND'"))

(rule "ISL_02: VCC VCC Q1 tab F.Cu stays whole"
	(layer F.Cu)
	(constraint disallow track)
	(condition "A.intersectsArea('ISL_02') && A.NetName != 'VCC'"))

