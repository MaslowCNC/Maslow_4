	(text "36V INRUSH SOFT-START (DRV8251A VM ramp must stay < 2V/us)\nQ1 source on XT60 (VIN_RAW), drain to VCC. C72 holds Vgs ~0 at plug-in;\nR60 pulls the gate down, C73 (Miller) sets the VCC ramp:\n~(VIN-3.5V)/R60/C73 = ~1.5 V/ms at 36V -> ~25 ms, ~2A into ~1.2 mF.\nSteady Vgs = VIN*R59/(R59+R60) = 11.5V @36V; D6 clamps Vgs at 15V."
		(exclude_from_sim no)
		(at -845.00 372.00 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4d5fb1f7-1b48-46ac-86fb-6b020bdb53b7")
	)
