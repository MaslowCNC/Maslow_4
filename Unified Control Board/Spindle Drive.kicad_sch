	(text "SPINDLE MCU  STM32G474RBT3 (HSI16, no crystal). Flashed by the XY ESP32 through the ROM bootloader on USART2 (BoardCOM1/2, BOOT, RST)."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "998910e3-2b90-40e0-abff-f20998c9cd7e")
	)
	(text "Motor 1: TIM1 CH1-3 PC0-PC2, CH1N/CH2N PA11/PA12, CH3N PB15.  Motor 2: TIM8 CH1-3 PC6-PC8, CH1N-CH3N PB3/PB4/PC12."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "56df2081-7e97-49ac-ad04-d77eea7fee0a")
	)
	(text "Shunt sense: OPAMP1-6 in PGA mode (gain 16, internal output to ADC1/2/3 and ADC5/5/4) on PA1/PA7/PB0 and PB11/PB14/PB13,"
		(exclude_from_sim no)
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "3661838d-5ead-4ffc-9a89-dbb4742e1b06")
	)
	(text "which are also COMP1/2/4 and COMP6/7/5 inputs: DAC threshold -> TIM1/TIM8 break for hardware over-current."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "cdc27d87-0c03-4abf-8cde-a97a89b24c04")
	)
	(text "Sense: Vin = 3V3A/32.6 + 0.969*I*5m -> PGA x16: 1.62 V at 0 A, 77.5 mV/A, about +-21 A full scale, 10 mA/LSB."
		(exclude_from_sim no)
		(at 25.4 39.37 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "a6d3b42c-883e-404a-b4ea-7f8f2b629afa")
	)
	(text "12 V GATE DRIVE (BCX56 + 13 V zener, ~12.3 V, <20 mA)"
		(exclude_from_sim no)
		(at 25.4 307.34 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "b24fbb4f-8d7b-42df-9301-a9d2b5afa2b0")
	)
	(text "POWER STAGE  MOTOR 1 (CN9)  DRV8300D: MODE and DT open = non-inverted INL, 200 ns dead time"
		(exclude_from_sim no)
		(at 165.1 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "ad483670-fe65-46fc-b24f-01136d742020")
	)
	(text "POWER STAGE  MOTOR 2 (CN11)"
